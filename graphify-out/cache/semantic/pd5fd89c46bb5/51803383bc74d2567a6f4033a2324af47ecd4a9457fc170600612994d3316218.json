{"nodes": [{"author": null, "captured_at": null, "contributor": null, "file_type": "document", "id": "docs_medical_docs_ddi_text_antipsychotics_clozapine_clozapine", "label": "Clozapine (Clozaril, Versacloz)", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "source_url": null}, {"author": null, "captured_at": null, "contributor": null, "file_type": "concept", "id": "docs_medical_docs_ddi_text_antipsychotics_clozapine_second_generation_antipsychotics", "label": "Second-Generation (Atypical) Antipsychotics", "rationale": "Second-generation agents are grouped by combined D2 and 5-HT2 antagonism with lower EPS liability than first-generation drugs but higher metabolic risk, which is why monographs share metabolic-change warnings and glucose/lipid monitoring advice.", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "source_url": null}, {"author": null, "captured_at": null, "contributor": null, "file_type": "concept", "id": "docs_medical_docs_ddi_text_antipsychotics_clozapine_cyp1a2_metabolism", "label": "CYP1A2-Mediated Drug Metabolism", "rationale": "Clozapine clearance depends heavily on CYP1A2, so strong CYP1A2 inhibitors require a dose reduction to one-third while smoking induction lowers levels, explaining the monograph's dose-modification table.", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "source_url": null}, {"author": null, "captured_at": null, "contributor": null, "file_type": "concept", "id": "docs_medical_docs_ddi_text_antipsychotics_clozapine_agranulocytosis_neutropenia_monitoring", "label": "Agranulocytosis and Neutropenia Monitoring", "rationale": "Clozapine can cause severe neutropenia progressing to fatal infection, so therapy may only start above strict ANC thresholds with regular monitoring and mandatory interruption or discontinuation rules, including modified thresholds for benign ethnic neutropenia.", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "source_url": null}], "edges": [{"confidence": "EXTRACTED", "confidence_score": 1.0, "relation": "references", "source": "docs_medical_docs_ddi_text_antipsychotics_clozapine_clozapine", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "target": "docs_medical_docs_ddi_text_antipsychotics_clozapine_second_generation_antipsychotics", "weight": 1.0}, {"confidence": "EXTRACTED", "confidence_score": 1.0, "relation": "references", "source": "docs_medical_docs_ddi_text_antipsychotics_clozapine_clozapine", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "target": "docs_medical_docs_ddi_text_antipsychotics_thioridazine_thioridazine", "weight": 1.0}, {"confidence": "EXTRACTED", "confidence_score": 1.0, "relation": "references", "source": "docs_medical_docs_ddi_text_antipsychotics_clozapine_clozapine", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "target": "docs_medical_docs_ddi_text_antipsychotics_clozapine_cyp1a2_metabolism", "weight": 1.0}, {"confidence": "EXTRACTED", "confidence_score": 1.0, "relation": "references", "source": "docs_medical_docs_ddi_text_antipsychotics_clozapine_clozapine", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "target": "docs_medical_docs_ddi_text_antipsychotics_clozapine_agranulocytosis_neutropenia_monitoring", "weight": 1.0}, {"confidence": "EXTRACTED", "confidence_score": 1.0, "relation": "references", "source": "docs_medical_docs_ddi_text_antipsychotics_clozapine_clozapine", "source_file": "docs/medical-docs/DDI-text/Antipsychotics/Clozapine.txt", "source_location": null, "target": "docs_medical_docs_ddi_text_antipsychotics_iloperidone_dementia_related_psychosis_mortality_warning", "weight": 1.0}], "hyperedges": []}