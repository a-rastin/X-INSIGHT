{"nodes": [{"author": null, "captured_at": null, "contributor": null, "file_type": "document", "id": "docs_medical_docs_ddi_text_mood_stabilizers_and_anticonvulsants_lithium_lithium", "label": "Lithium (Eskalith, Lithobid)", "source_file": "docs/medical-docs/DDI-text/Mood Stabilizers and Anticonvulsants/Lithium.txt", "source_location": null, "source_url": null}, {"author": null, "captured_at": null, "contributor": null, "file_type": "rationale", "id": "docs_medical_docs_ddi_text_mood_stabilizers_and_anticonvulsants_lithium_qtc_prolongation", "label": "QTc prolongation risk of lithium combinations", "rationale": "Lithium combined with other QTc-prolonging drugs such as dronedarone, thioridazine, amiodarone, or buprenorphine raises arrhythmia risk, so such combinations are contraindicated or require ECG monitoring and alternatives.", "source_file": "docs/medical-docs/DDI-text/Mood Stabilizers and Anticonvulsants/Lithium.txt", "source_location": null, "source_url": null}, {"author": null, "captured_at": null, "contributor": null, "file_type": "rationale", "id": "docs_medical_docs_ddi_text_mood_stabilizers_and_anticonvulsants_lithium_renal_clearance_monitoring", "label": "Renal clearance and serum monitoring of lithium", "rationale": "Lithium is cleared renally with a narrow therapeutic window (acute 0.8-1.2 mEq/L, maintenance 0.8-1.0 mEq/L), so renal impairment, interacting drugs that reduce clearance, and serum monitoring 12 hours post-dose drive dosing decisions.", "source_file": "docs/medical-docs/DDI-text/Mood Stabilizers and Anticonvulsants/Lithium.txt", "source_location": null, "source_url": null}], "edges": [{"confidence": "EXTRACTED", "confidence_score": 1.0, "relation": "references", "source": "docs_medical_docs_ddi_text_mood_stabilizers_and_anticonvulsants_lithium_lithium", "source_file": "docs/medical-docs/DDI-text/Mood Stabilizers and Anticonvulsants/Lithium.txt", "source_location": null, "target": "docs_medical_docs_ddi_text_substance_use_and_smoking_cessa